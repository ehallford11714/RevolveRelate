{
  "title": "RevolveRelate analytics primitives",
  "description": "Schema-agnostic RelOp atoms. Chain them into composites to answer any business question. Bind to SchemaGraph at apply time. Never SQL. Add rows here to scale a family later.",
  "families": [
    {"id": "source", "title": "Where the relation starts"},
    {"id": "grain", "title": "How entities are joined"},
    {"id": "restrict", "title": "Row predicates"},
    {"id": "project", "title": "Shape, sort, limit"},
    {"id": "aggregate", "title": "Group and reduce"},
    {"id": "window", "title": "Partitioned / running calculations"},
    {"id": "set", "title": "Union, except, intersect"},
    {"id": "derive", "title": "Row-level arithmetic and cases"},
    {"id": "cut", "title": "Top, threshold, pareto, buckets"},
    {"id": "time", "title": "Date grain and periods"},
    {"id": "compare", "title": "Now versus a baseline"},
    {"id": "stat", "title": "Describe a distribution"},
    {"id": "quality", "title": "Profile the relation"},
    {"id": "shape", "title": "Change grain or layout"},
    {"id": "calendar", "title": "Fiscal and workday algebra"},
    {"id": "sequence", "title": "Ordered events per entity"},
    {"id": "hierarchy", "title": "Trees and subtotals"},
    {"id": "nested", "title": "Arrays and JSON"},
    {"id": "match", "title": "Approximate alignment"},
    {"id": "chunk", "title": "Split text into retrieve units"},
    {"id": "vector", "title": "Embed, overlay, knn, and similarity join"},
    {"id": "intent", "title": "Objective, goal, and Socratic sub-questions"},
    {"id": "world", "title": "Named views, interventions, and the act log"},
    {"id": "search", "title": "Abduce, ideate, and explore legal RelOp"}
  ],
  "primitives": [
