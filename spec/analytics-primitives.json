    {"id": "star_join", "family": "source", "title": "Fact plus every needed bound entity", "binds": ["measure", "dimension", "date"]},
    {"id": "distinct_scan", "family": "source", "title": "Distinct rows of a dimension entity", "binds": ["dimension"]},
    {"id": "sample_limit", "family": "source", "title": "Cap the current relation", "binds": ["n"]},
