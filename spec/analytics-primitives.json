    {"id": "attach_source", "family": "vector", "title": "Join overlay chunks back to their source entity", "binds": ["entity"]},
    {"id": "rerank", "family": "vector", "title": "Re-sort overlay hits by hash distance to the query", "binds": ["query", "n"]},
    {"id": "attach_fact", "family": "vector", "title": "Join overlay hits to the fact grain (and optional slice)", "binds": ["entity", "column", "value"]},
    {"id": "role_is", "family": "vector", "title": "Keep overlay chunks whose causal Role matches (cause, effect, condition, …)", "binds": ["value"]},
    {"id": "filter_cue", "family": "vector", "title": "Keep overlay chunks whose discourse Cue matches", "binds": ["value"]},
    {"id": "pair_causal", "family": "vector", "title": "Self-join cause chunks to effect chunks on SourcePk and Cue", "binds": ["left", "right"]},

    {"id": "objective", "family": "intent", "title": "Bind an English objective onto the current relation", "binds": ["query"]},
    {"id": "goal", "family": "intent", "title": "Score a measure against a target (utility)", "binds": ["measure", "threshold"]},
    {"id": "socratic", "family": "intent", "title": "Decompose an objective into sub-questions and named composites", "binds": ["query"]},

    {"id": "ask_log", "family": "world", "title": "Scan the dummy act log (questions, RelOp hashes, tickets)", "binds": []},
    {"id": "hypothesize", "family": "world", "title": "Name the current RelOp as a dummy CTE view", "binds": ["name"]},
    {"id": "intervene", "family": "world", "title": "What-if CASE rewrite of a measure when a slice holds (never a live update)", "binds": ["measure", "column", "value", "threshold"]},
    {"id": "vs_world", "family": "compare", "title": "Sum observed vs intervened by dimension", "binds": ["dimension"]},

    {"id": "abduce", "family": "search", "title": "Pick the legal composite that best matches the objective", "binds": ["query"]},
    {"id": "ideate", "family": "search", "title": "Enumerate legal RelOp candidates for an objective", "binds": ["query"]},
    {"id": "explore", "family": "search", "title": "Socratic decompose then list ideate candidates", "binds": ["query"]}
  ],
