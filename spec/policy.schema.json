{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revolverelate.dev/spec/policy.schema.json",
  "title": "QueryPolicy",
  "description": "SLM may propose this object. A deterministic checker must accept it before use.",
  "type": "object",
  "required": ["version", "attributes", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["public", "internal", "critical", "pii"]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["read_sandbox", "read_live", "mutate_sandbox", "mutate_live", "call_procedure", "reveal"]
      }
    },
    "entityAllowlist": { "type": "array", "items": { "type": "string" } },
    "rowPredicates": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "procedures": { "type": "array", "items": { "type": "string" } },
    "reveal": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
